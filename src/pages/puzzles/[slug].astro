---
import Base from '../../layouts/Base.astro';
import MetadataStripe from '../../components/MetadataStripe.astro';
import PuzzleViews from '../../components/PuzzleViews.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  // Build every essay's page, drafts included. Drafts are unlinked
  // from the homepage (index.astro filters them); the /drafts/ index
  // is their entry point.
  const essays = await getCollection('essays');
  return essays.map(essay => ({
    params: { slug: essay.id },
    props: { essay },
  }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);

// Essays with a graph dashboard built. As more land, add the slug here.
const slugsWithGraph = new Set([
  'know-thyself',
  'restorative-yoga-and-biology-of-belonging',
]);
const hasGraph = slugsWithGraph.has(essay.id);

// Per-essay etude track. null = no etudes built yet.
const etudesBySlug: Record<string, string | null> = {
  // know-thyself etudes unlinked (2026-07-02): the essay stands on its own.
  'restorative-yoga-and-biology-of-belonging': '/etudes/restorative/',
};
const etudesUrl = etudesBySlug[essay.id] ?? null;

// Footnotes live on their own /notes/ tab so the essay reads clean.
// Build the tab only when the essay actually carries footnotes.
const hasNotes = /^\[\^[^\]]+\]:\s/m.test(essay.body ?? '');
const notesUrl = `/puzzles/${essay.id}/notes/`;
---
<Base title={essay.data.title} description={essay.data.description ?? essay.data.subtitle}>
  <article class="essay h-entry">
    {essay.data.kicker && <p class="essay-kicker">{essay.data.kicker}</p>}
    <h1 class="p-name">{essay.data.title}</h1>
    {(essay.data.subtitle || essay.data.relief) && (
      <p class="essay-sub p-summary">
        {essay.data.subtitle}
        {essay.data.subtitle && essay.data.relief && <span class="essay-sub-sep"> · </span>}
        {essay.data.relief && <em class="essay-sub-relief">{essay.data.relief}</em>}
      </p>
    )}
    <PuzzleViews
      slug={essay.id}
      activeView="essay"
      etudesUrl={etudesUrl}
      hasGraph={hasGraph}
      hasNotes={hasNotes}
    />
    <div class="essay-body e-content" data-notes-url={hasNotes ? notesUrl : undefined}>
      <Content />
    </div>

    <footer class="essay-provenance">
      <MetadataStripe
        publishedAt={essay.data.publishedAt}
        updatedAt={essay.data.updatedAt}
        status={essay.data.status}
        confidence={essay.data.confidence}
      />
    </footer>

    <a class="u-url" href={`/puzzles/${essay.id}/`} hidden>{essay.data.title}</a>
    <span class="p-author h-card" hidden>parrik</span>
  </article>
</Base>

<style is:global>
  /* Footnotes moved to the /notes/ tab — hide the rendered block on the
     essay view so the prose reads clean. Scoped to .e-content so the
     notes page (.notes-only) still shows the same section. */
  .essay-body.e-content section[data-footnotes] {
    display: none;
  }
</style>

<script is:inline>
  // Send in-body footnote markers ([1], [2], …) to the notes tab at the
  // matching anchor, since the footnote text no longer lives on this page.
  document.querySelectorAll('.essay-body.e-content[data-notes-url]').forEach((body) => {
    const notesUrl = body.getAttribute('data-notes-url');
    if (!notesUrl) return;
    body.querySelectorAll('a[data-footnote-ref]').forEach((a) => {
      const hash = a.getAttribute('href') || '';
      if (hash.startsWith('#')) a.setAttribute('href', notesUrl + hash);
    });
  });
</script>
