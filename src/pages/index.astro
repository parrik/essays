---
import Base from '../layouts/Base.astro';
import { getCollection } from 'astro:content';

const all = await getCollection('essays');

// Homepage = top-level essays only — no parent. Series children
// and standalone drafts live on /drafts/ instead of crowding the
// front page.
const list = all
  .filter(e => !e.data.parent && !e.data.draft)
  .sort((a, b) => {
    const ad = a.data.publishedAt ? +a.data.publishedAt : 0;
    const bd = b.data.publishedAt ? +b.data.publishedAt : 0;
    return bd - ad;
  });
---
<Base title="parrik">
  <section class="essays">
    <ul>
      {list.map(essay => {
        // Homepage register is engineering-first — show the technical
        // subtitle. The felt `relief` line lives on the per-essay page.
        const subtitle = essay.data.subtitle ?? essay.data.relief;
        return (
          <li>
            <div class="essay-row">
              <a href={`/puzzles/${essay.id}/`} class="essay-link">
                <span class="essay-title">{essay.data.title}</span>
              </a>
            </div>
            {subtitle && <p class="essay-subtitle">{subtitle}</p>}
          </li>
        );
      })}
    </ul>
  </section>
</Base>
