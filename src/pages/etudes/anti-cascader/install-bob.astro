    { kind: 'block', cls: 'term-stop', lines: [
      '┌─ done ─────────────────────────────────────────────────',
      '│ All seven steps walked. Five PRs landed (02-06); two',
      '│ gate trailers (01, 07) recorded directly to git log.',
      '│ Repo is on Spring Boot 3.',
      '│',
      '│ State lives in git log. A teammate running',
      '│ /migrate-spring-boot-3 sees: nothing to do.',
      '└────────────────────────────────────────────────────────',
    ]},
  ];

  const term = document.getElementById('term-body');
  const playBtn = document.getElementById('play');
  const resetBtn = document.getElementById('reset');
  const speedSel = document.getElementById('speed');
  const banner = document.getElementById('banner');
  const stepBar = document.getElementById('step-bar');
  // The step ids in display order — used to compute done/active/pending
  // when a `step` frame fires.
  const STEP_ORDER = ['install','1','2','3','4','5','6','7'];

  function setStep(id) {
    if (!stepBar) return;
    const idx = STEP_ORDER.indexOf(id);
    if (idx < 0) return;
    const items = stepBar.querySelectorAll('li');
    items.forEach(li => {
      const liId = li.getAttribute('data-step');
      const liIdx = STEP_ORDER.indexOf(liId);
      li.classList.remove('step-active','step-done','step-pending');
      if (liIdx < idx) li.classList.add('step-done');
      else if (liIdx === idx) li.classList.add('step-active');
      else li.classList.add('step-pending');
    });
  }

  function resetStepBar() {
    if (!stepBar) return;
    const items = stepBar.querySelectorAll('li');
    items.forEach(li => {
      li.classList.remove('step-active','step-done');
      li.classList.add('step-pending');
    });
  }

  let running = false;
  let cancelled = false;

  function speedMul() { return parseFloat(speedSel.value || '1'); }
  function pace(ms) { return ms / speedMul(); }

  function append(html) {
    const d = document.createElement('div');
    d.innerHTML = html;
    term.appendChild(d);
    term.scrollTop = term.scrollHeight;
    return d;
  }

  function appendText(text, cls = '') {
    return append(`<span class="${cls}">${escapeHtml(text)}</span>`);
  }

  function escapeHtml(s) {
    return String(s).replace(/[&<>]/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;'}[c]));
  }

  function sleep(ms) {
    return new Promise(res => {
      const id = setTimeout(() => res(), pace(ms));
      sleep._cancel = () => { clearTimeout(id); res(); };
    });
  }

  async function typeLine(text, prefix = '') {
    const row = append(`<div class="term-line"><span class="term-prefix">${prefix}</span><span class="term-typed"></span><span class="caret">▍</span></div>`);
    const target = row.querySelector('.term-typed');
    for (const ch of text) {
      if (cancelled) return;
      target.textContent += ch;
      await sleep(28);
    }
    row.querySelector('.caret')?.remove();
    await sleep(120);
  }

  async function progressBar(total) {
    const row = append(`<div class="term-progress"><span class="bar"><span class="fill" style="width:0%"></span></span><span class="pct">0/${total}</span></div>`);
    const fill = row.querySelector('.fill');
    const pct = row.querySelector('.pct');
    for (let i = 1; i <= total; i++) {
      if (cancelled) return;
      const w = Math.round((i / total) * 100);
      fill.style.width = w + '%';
      pct.textContent = `${i}/${total}`;
      await sleep(110);
    }
  }

  async function renderFrame(f) {
    if (cancelled) return;
    switch (f.kind) {
      case 'step':
        setStep(f.id);
        // No terminal output — the stepper is the side-channel UI.
        break;
      case 'prompt':
        append(`<div class="term-line term-shellprompt"><span class="term-prefix">${escapeHtml(f.text)} </span></div>`);
        break;
      case 'cc-prompt':
        append(`<div class="term-line term-ccprompt"><span class="term-prefix">&gt; </span></div>`);
        break;
      case 'type': {
        const last = term.querySelector('.term-line:last-child');
        if (last) {
          const typed = document.createElement('span');
          typed.className = 'term-typed';
          last.appendChild(typed);
          const caret = document.createElement('span');
          caret.className = 'caret';
          caret.textContent = '▍';
          last.appendChild(caret);
          for (const ch of f.text) {
            if (cancelled) return;
            typed.textContent += ch;
            await sleep(26);
          }
          last.querySelector('.caret')?.remove();
        }
        break;
      }
      case 'enter':
        await sleep(220);
        break;
      case 'echo':
        appendText(f.text, 'term-echo');
        await sleep(140);
        break;
      case 'block': {
        const wrap = append(`<div class="${f.cls}"></div>`);
        const isDiff = f.cls && f.cls.indexOf('term-diff') !== -1;
        for (const ln of f.lines) {
          if (cancelled) return;
          const line = document.createElement('div');
          line.className = 'term-block-line';
          if (isDiff) {
            // Color +/- lines green/red; leave file headers and
            // context lines in the default block color.
            if (ln.startsWith('+')) line.classList.add('diff-add');
            else if (ln.startsWith('-')) line.classList.add('diff-del');
            else if (ln && !ln.startsWith(' ') && ln.indexOf('/') !== -1) {
              line.classList.add('diff-file');
            }
          }
          line.textContent = ln;
          wrap.appendChild(line);
          await sleep(70);
        }
        await sleep(180);
        break;
      }
      case 'progress':
        await progressBar(f.total);
        await sleep(140);
        break;
      case 'gap':
        append(`<div class="term-gap"></div>`);
        await sleep(180);
        break;
      case 'gap-long':
        // Beat that lets the viewer read the prior block (explanation,
        // settled state after a PR opens). Longer than `gap`; not a
        // section break.
        append(`<div class="term-gap"></div>`);
        await sleep(900);
        break;
      case 'clear': {
        // Section break between steps. Scroll the prior content out
        // (don't destroy it — viewer can scroll up if they want to
        // re-read) by appending a tall spacer that pushes the new
        // step's first line to the top of the viewport.
        const spacer = document.createElement('div');
        spacer.className = 'term-clear-spacer';
        term.appendChild(spacer);
        // Force a repaint, then scroll the spacer into view so the
        // next echo appears at the top of the visible terminal area.
        await sleep(60);
        spacer.scrollIntoView({ behavior: 'smooth', block: 'start' });
        await sleep(360);
        break;
      }
    }
  }

  async function play() {
    if (running) return;
    running = true; cancelled = false;
    playBtn.disabled = true; resetBtn.disabled = true;
    banner.className = 'banner';
    banner.innerHTML = '';
    term.innerHTML = '';
    resetStepBar();

    for (const f of FRAMES) {
      if (cancelled) break;
      await renderFrame(f);
    }

    if (!cancelled) {
      banner.className = 'banner banner-shown';
      banner.innerHTML = '<strong>All seven steps walked.</strong> Five draft PRs in the team\'s queue (steps 02–05 and any rewrites from step 06); two gate trailers (steps 01, 07) recorded directly to <code>git log</code>. <em>Team-paced. No platform-team push.</em>';
    }

    running = false;
    playBtn.disabled = false;
    resetBtn.disabled = false;
  }

  function reset() {
    cancelled = true;
    if (sleep._cancel) sleep._cancel();
    term.innerHTML = '';
    banner.className = 'banner';
    banner.innerHTML = '';
    // Reset stepper to all-pending and mark "install" active (first step).
    resetStepBar();
    setStep('install');
    running = false;
    playBtn.disabled = false;
    resetBtn.disabled = true;
  }

  playBtn.addEventListener('click', play);
  resetBtn.addEventListener('click', reset);

  // Initial stepper state: install is the first cell, mark it active so the
  // viewer sees the bar-shape before pressing play.
  setStep('install');
</script>

